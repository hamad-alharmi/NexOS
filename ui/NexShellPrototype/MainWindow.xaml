<Window
    x:Class="NexShellPrototype.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NexShell">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0D1018" Offset="0.0" />
                <GradientStop Color="#141A2B" Offset="0.55" />
                <GradientStop Color="#1F2B47" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="#2B3C63" />
                <Setter Property="Foreground" Value="#F2F6FF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="84" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="18,14,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#F0F4FF" Text="NexShell" />
                <TextBlock Foreground="#AFC0E8" Text="Performance-first desktop control center" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ClockText"
                           HorizontalAlignment="Right"
                           FontSize="18"
                           Foreground="#E8EEFF"
                           Text="--:--:--" />
                <TextBlock x:Name="DateText"
                           HorizontalAlignment="Right"
                           Foreground="#AFC0E8"
                           Text="----/--/--" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="18,8,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="14" Padding="16" Margin="0,0,12,0" Background="#6630446E">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#F0F4FF" Text="System Controls" />
                    <TextBlock Foreground="#C8D5F8" Text="Run profile presets, toggle game mode, and launch common tools." />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="EnableGameModeButton" Content="Enable Game Mode" Click="EnableGameMode_Click" />
                        <Button x:Name="DisableGameModeButton" Content="Disable Game Mode" Click="DisableGameMode_Click" />
                        <Button Content="Optimize Idle" Click="OptimizeIdle_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="PresetComboBox" Width="220" SelectedIndex="0">
                            <ComboBoxItem Content="GamingMode" />
                            <ComboBoxItem Content="MinimalMode" />
                            <ComboBoxItem Content="AestheticMode" />
                        </ComboBox>
                        <Button Content="Apply Preset" Click="ApplyPreset_Click" />
                        <Button Content="Export Diagnostics" Click="ExportDiagnostics_Click" />
                    </StackPanel>

                    <TextBox x:Name="QuickLaunchTextBox"
                             PlaceholderText="Quick launch (type executable path or URI)"
                             KeyDown="QuickLaunchTextBox_KeyDown" />
                    <Button Content="Launch Input" Click="QuickLaunch_Click" />

                    <TextBlock x:Name="StatusText" Foreground="#9CF2B4" Text="Status: Ready" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="14" Padding="16" Background="#6632354F">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#F0F4FF" Text="Launchpad" />
                    <TextBlock Foreground="#C8D5F8" Text="One-click launch for common gaming and system applications." />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Steam" Click="OpenSteam_Click" />
                        <Button Grid.Row="1" Content="Epic Games" Click="OpenEpic_Click" />
                        <Button Grid.Row="2" Content="Battle.net" Click="OpenBattleNet_Click" />
                        <Button Grid.Row="3" Content="Windows Settings" Click="OpenSettings_Click" />
                        <Button Grid.Row="4" Content="Presets Folder" Click="OpenPresets_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="18,6,18,14" Background="#55212C47" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Foreground="#C8D5F8" Text="NexOS Control Plane" />
                    <TextBlock Margin="12,0,0,0" Foreground="#8DE1A5" Text="Gaming + Privacy + Control" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="Open GitHub" Click="OpenGitHub_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
